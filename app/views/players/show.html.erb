<% content_for :title, "#{@player.name} · KFL" %>
<%= render "shared/back_link", label: "Leaderboard", path: root_path(mode: current_mode) %>
<div class="flex items-center justify-between">
  <h1 class="text-3xl font-bold tracking-tight"><%= @player.name %></h1>
  <%= render "shared/mode_toggle", mode: current_mode, path: { name: :player_path, args: [ @player ] } %>
</div>

<% if @results.empty? %>
  <p class="mt-6 text-base text-slate-500">No <%= mode_label(current_mode) %> games yet.</p>
<% else %>
  <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-4">
    <div class="flex items-baseline gap-2">
      <span class="text-5xl font-bold tabular-nums"><%= rating_text(@player.rating(current_mode)) %><% if @player.provisional?(current_mode) %><span class="text-slate-400" title="Fewer than <%= Elo::UNSETTLED_GAMES %> games">?</span><% end %></span>
      <span class="text-base text-slate-500">#<%= @player.rank(current_mode) %> in <%= mode_label(current_mode) %></span>
    </div>
    <div class="mt-2"><%= rating_chart(RatingHistory.for_player(@player, current_mode)) %></div>
  </div>

  <dl class="mt-3 grid grid-cols-2 gap-3 text-base sm:grid-cols-4">
    <% [
      [ "Record", "#{@player.wins(current_mode)}-#{@player.losses(current_mode)}" ],
      [ "Win rate", percent_text(@player.win_rate(current_mode)) ],
      [ "Streak", @player.current_streak(current_mode).label, streak_class(@player.current_streak(current_mode)) ],
      [ "Best win streak", "#{@player.longest_win_streak(current_mode)}W", "" ],
      [ "Net profit", money_delta_text(@bets.net_cents), money_class(@bets.net_cents) ]
    ].each do |label, value, color| %>
      <div class="rounded-xl border border-slate-200 bg-white px-3 py-3">
        <dt class="text-sm text-slate-500"><%= label %></dt>
        <dd class="text-xl font-semibold tabular-nums <%= color %>"><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <% if @partnerships.present? %>
    <h2 class="mt-8 text-base font-semibold uppercase tracking-wide text-slate-500">Partners</h2>
    <ul class="mt-2 divide-y divide-slate-200 text-base">
      <% @partnerships.each do |pair| %>
        <li>
          <%= link_to team_path(pair), class: "flex justify-between py-3 hover:text-blue-600" do %>
            <span><%= (pair.players - [ @player ]).first.name %></span>
            <span class="text-slate-500 tabular-nums"><%= pair.wins %>-<%= pair.losses %> · <%= percent_text(pair.win_rate) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% records = [
    [ "Nemesis", @nemesis && @nemesis.other.name, @nemesis && "#{@nemesis.wins}-#{@nemesis.losses} against them", nil ],
    [ "Victim", @victim && @victim.other.name, @victim && "#{@victim.wins}-#{@victim.losses} against them", nil ],
    [ "Biggest upset", @upset && names(@upset.opponents), @upset && "#{@upset.points}–#{@upset.opponent_points} · #{percent_text(@upset.game.chance_for(@upset.side))} chance", @upset&.game ],
    [ "Biggest blowout", @blowout && names(@blowout.opponents), @blowout && "#{@blowout.points}–#{@blowout.opponent_points}", @blowout&.game ],
    [ "Worst loss", @worst_loss && names(@worst_loss.opponents), @worst_loss && "#{@worst_loss.points}–#{@worst_loss.opponent_points}", @worst_loss&.game ]
  ].select { |_, name| name } %>
  <% if records.any? %>
    <h2 class="mt-8 text-base font-semibold uppercase tracking-wide text-slate-500">Records</h2>
    <dl class="mt-2 grid grid-cols-2 gap-3 text-base">
      <% records.each do |label, name, detail, game| %>
        <%= render "players/record", label: label, name: name, detail: detail, game: game %>
      <% end %>
    </dl>
  <% end %>
  <h2 class="mt-8 text-base font-semibold uppercase tracking-wide text-slate-500">Head to head · <%= mode_label(current_mode) %></h2>
  <ul class="mt-2 divide-y divide-slate-200 text-base">
    <% @rivalries.each do |rivalry| %>
      <li class="flex justify-between py-3">
        <% if current_mode == "singles" %>
          <%= link_to "vs #{rivalry.other.name}", head_to_head_path(mode: "singles", side_a_player_ids: [ @player.id ], side_b_player_ids: [ rivalry.other.id ]), class: "text-blue-600 hover:underline" %>
        <% else %>
          <span>vs <%= rivalry.other.name %></span>
        <% end %>
        <span class="text-slate-500 tabular-nums"><%= rivalry.wins %>-<%= rivalry.losses %> · <span class="font-semibold text-slate-900"><%= percent_text(rivalry.win_rate) %></span></span>
      </li>
    <% end %>
  </ul>

  <div class="mt-8 flex items-baseline justify-between">
    <h2 class="text-base font-semibold uppercase tracking-wide text-slate-500">Recent games</h2>
    <%= link_to "View all →", games_path(player_id: @player.id, mode: current_mode), class: "text-base text-blue-600 hover:underline" %>
  </div>
  <div class="mt-2 divide-y divide-slate-200">
    <% @results.first(8).each do |result| %>
      <%= render "shared/game", game: result.game, perspective: result %>
    <% end %>
  </div>
<% end %>
