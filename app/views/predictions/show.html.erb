<% content_for :title, "Predict · KFL" %>
<%= render "shared/versus_tabs", active: :predict %>
<h1 class="text-2xl font-semibold tracking-tight">Predict a game</h1>
<p class="mt-1 text-base text-slate-500">Pick the teams and see the likely score.</p>

<%= form_with url: prediction_path, method: :get, data: { controller: "game-form", action: "amount:change->game-form#betChanged", game_form_auto_submit_value: true, turbo_frame: "prediction" }, class: "mt-4 space-y-6" do |form| %>
  <div class="flex w-full rounded-full bg-slate-200 p-1 text-base sm:w-64">
    <% Game.modes.each_key do |mode| %>
      <label class="flex-1 cursor-pointer">
        <%= radio_button_tag :mode, mode, current_mode == mode, class: "peer sr-only", data: { action: "game-form#changeMode", game_form_target: "mode" } %>
        <span class="block rounded-full px-4 py-2 text-center font-medium text-slate-500 peer-checked:bg-white peer-checked:text-slate-900 peer-checked:shadow-sm"><%= mode_label(mode) %></span>
      </label>
    <% end %>
  </div>

  <% { "a" => [ "Team 1", @side_a_ids ], "b" => [ "Team 2", @side_b_ids ] }.each do |side, (label, ids)| %>
    <fieldset>
      <legend class="text-base font-semibold uppercase tracking-wide text-slate-500"><%= label %></legend>
      <%= render "shared/team_picker", side: side, label: label, players: @players, selected_ids: ids, name_prefix: "", name_suffix: "" %>
    </fieldset>
  <% end %>

  <fieldset>
    <legend class="text-base font-semibold uppercase tracking-wide text-slate-500">
      Bet <span class="font-normal normal-case tracking-normal text-slate-400">· optional</span>
    </legend>
    <%= render "shared/amount_field", form: form, field: :bet_dollars, value: params[:bet_dollars].to_i.clamp(0, 999) %>
  </fieldset>

<% end %>

<%= turbo_frame_tag "prediction", target: "_top", data: { game_form_target: "result" } do %>
  <% if @error %>
    <p class="mt-6 rounded-lg bg-rose-50 px-3 py-3 text-base text-rose-800"><%= @error %></p>
  <% elsif @prediction %>
    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 text-center">
      <p class="text-base text-slate-500">Predicted score</p>
      <div class="mt-2 grid grid-cols-[1fr_auto_1fr] items-center gap-3">
        <p class="min-w-0 break-words text-right text-base font-semibold"><%= @prediction.favorite.map(&:name).to_sentence(two_words_connector: " & ") %></p>
        <p class="text-5xl font-bold tabular-nums"><%= Prediction::TABLE_MAX %>–<%= @prediction.underdog_points %></p>
        <p class="min-w-0 break-words text-left text-base text-slate-500"><%= @prediction.underdog.map(&:name).to_sentence(two_words_connector: " & ") %></p>
      </div>
      <p class="mt-4 text-base">
        <span class="text-xl font-semibold text-blue-600 tabular-nums"><%= percent_text(@prediction.confidence) %></span>
        <span class="text-slate-500">confident <%= @prediction.favorite.map(&:name).to_sentence(two_words_connector: " & ") %> win</span>
      </p>
    </section>

    <section class="mt-3 rounded-2xl border border-slate-200 bg-white p-5">
      <p class="text-center text-base text-slate-500">Elo at <%= Prediction::TABLE_MAX %>–<%= @prediction.underdog_points %></p>
      <div class="mt-3 divide-y divide-slate-200">
        <% [ @prediction.favorite, @prediction.underdog ].each do |team| %>
          <% loser = team.equal?(@prediction.favorite) ? @prediction.underdog : @prediction.favorite %>
          <% change = @prediction.elo_change_if_wins(team) %>
          <p class="flex items-baseline justify-between gap-3 py-3 text-base">
            <span class="min-w-0 break-words text-slate-500">If <span class="font-medium text-slate-900"><%= team.map(&:name).to_sentence(two_words_connector: " & ") %></span> win</span>
            <span class="tabular-nums">
              <span class="font-semibold <%= delta_class(change) %>"><%= delta_text(change) %></span>
              <span class="text-slate-400">/</span>
              <span class="font-semibold text-rose-500"><%= delta_text(-change) %></span>
            </span>
          </p>
        <% end %>
      </div>
      <p class="text-center text-sm text-slate-400">Winners / losers, per player</p>
    </section>

    <% if @bet_cents.positive? %>
      <% terms = @prediction.bet_terms(@bet_cents) %>
      <section class="mt-3 rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-center text-base text-slate-500">Bet · <%= money_text(@bet_cents) %> from the underdog</p>
        <div class="mt-3 divide-y divide-slate-200">
          <% [ [ @prediction.favorite, terms.favorite_stake_cents, terms.underdog_stake_cents ], [ @prediction.underdog, terms.underdog_stake_cents, terms.favorite_stake_cents ] ].each do |team, risks, wins| %>
            <p class="flex items-baseline justify-between gap-3 py-3 text-base">
              <span class="min-w-0 break-words font-medium"><%= team.map(&:name).to_sentence(two_words_connector: " & ") %></span>
              <span class="text-slate-500">risks <span class="font-semibold text-slate-900 tabular-nums"><%= money_text(risks) %></span> to win <span class="font-semibold text-green-600 tabular-nums"><%= money_text(wins) %></span><%= " each" if @prediction.mode == "doubles" %></span>
            </p>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
<% end %>
