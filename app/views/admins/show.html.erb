<% content_for :title, "Admin · KFL" %>
<h1 class="text-2xl font-semibold tracking-tight">Admin</h1>
<p class="mt-1 text-base text-slate-500">Switches, health checks and upkeep for the league. Only admins can see this page.</p>

<%= render "shared/section_heading", title: "Settings", subtitle: "Switches that change how the whole league is scored." %>
<div class="mt-2 flex items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-4 text-base">
  <span class="min-w-0">
    <span class="block font-medium">Rating decay <span class="font-normal text-slate-500">· <%= @decay ? "on" : "off" %></span></span>
    <span class="block text-sm text-slate-500">Ratings drift toward <%= Elo::BASE_RATING.round %> after <%= Elo::DECAY_GRACE_DAYS %> idle days.</span>
  </span>
  <% if @decay %>
    <%= button_to "Turn off", decay_path, method: :delete, class: "shrink-0 whitespace-nowrap rounded-full bg-slate-200 px-4 py-2 font-medium text-slate-700 hover:bg-slate-300",
      form: { data: { turbo_confirm: "Turn off rating decay? Ratings will be recalculated." } } %>
  <% else %>
    <%= button_to "Turn on", decay_path, class: "shrink-0 whitespace-nowrap rounded-full bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700" %>
  <% end %>
</div>

<div class="mt-3 rounded-2xl border border-slate-200 bg-white px-4 py-4 text-base">
  <span class="block font-medium">Ratings formula <span class="font-normal text-slate-500">· version <%= FormulaVersion.current %></span></span>
  <span class="block text-sm text-slate-500">Ratings and records rebuild on their own after every game and whenever the formula changes, so there's nothing to recalculate by hand.</span>
</div>

<%= render "shared/section_heading", title: "Predictor accuracy", subtitle: "How often the pre-game win chance picked the winner, checked against every game played." %>
<% if @accuracy.games.zero? %>
  <p class="mt-2 text-base text-slate-500">No games yet.</p>
<% else %>
  <div class="mt-2 rounded-2xl border border-slate-200 bg-white p-4 text-base">
    <% if @accuracy.pick_accuracy %>
      <p>
        <span class="text-3xl font-bold tabular-nums"><%= percent_text(@accuracy.pick_accuracy) %></span>
        <span class="text-slate-500">of winners called · <%= @accuracy.correct_picks %> of <%= @accuracy.called.size %></span>
      </p>
    <% else %>
      <p class="text-slate-500">Every game so far was a toss-up, so there's nothing to score yet.</p>
    <% end %>
    <% if @accuracy.toss_ups.positive? %>
      <p class="mt-1 text-sm text-slate-400"><%= pluralize(@accuracy.toss_ups, "toss-up") %> (exactly 50%) left out.</p>
    <% end %>

    <dl class="mt-4 grid grid-cols-2 gap-3">
      <div class="rounded-xl bg-slate-50 px-3 py-3">
        <dt class="text-sm text-slate-500">Brier score</dt>
        <dd class="text-xl font-semibold tabular-nums"><%= number_with_precision(@accuracy.brier_score, precision: 3) %></dd>
        <dd class="text-xs text-slate-400">0.250 is a coin flip, lower is better</dd>
      </div>
      <div class="rounded-xl bg-slate-50 px-3 py-3">
        <dt class="text-sm text-slate-500">Score miss</dt>
        <dd class="text-xl font-semibold tabular-nums"><%= number_with_precision(@accuracy.margin_error, precision: 1) %> pts</dd>
        <dd class="text-xs text-slate-400">average gap in the predicted margin</dd>
      </div>
    </dl>

    <% if @accuracy.calibration.any? %>
      <h3 class="mt-5 text-sm font-semibold uppercase tracking-wide text-slate-500">Calibration</h3>
      <p class="text-sm text-slate-500">When the model gave the favourite this chance, how often did they really win?</p>
      <ul class="mt-1 divide-y divide-slate-100 text-base">
        <% @accuracy.calibration.each do |bucket| %>
          <li class="flex items-baseline justify-between gap-3 py-2">
            <span class="shrink-0 whitespace-nowrap tabular-nums"><%= (bucket.from * 100).round %>–<%= (bucket.to * 100).round %>%</span>
            <span class="text-right text-slate-500 tabular-nums">favourite won <span class="font-semibold text-slate-900"><%= percent_text(bucket.favorite_wins.fdiv(bucket.games)) %></span> of <%= pluralize(bucket.games, "game") %>
              <span class="text-slate-400">(expected <%= percent_text(bucket.expected) %>)</span></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% unless @accuracy.enough_games? %>
      <p class="mt-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-800">Only <%= @accuracy.games %> games so far, so these numbers will bounce around. Give it about <%= PredictorAccuracy::MIN_GAMES %>.</p>
    <% end %>
    <p class="mt-3 text-xs text-slate-400">Scored with each game's ratings going in, using today's formula.</p>
  </div>
<% end %>

<%= render "shared/section_heading", title: "Backups", subtitle: "A copy of the database is pushed to GitHub every night, and the last 30 days are kept." %>
<div class="mt-2 flex items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-4 text-base">
  <% if DatabaseBackup.configured? %>
    <span class="min-w-0">
      <span class="block font-medium">Last backup</span>
      <span class="block text-sm <%= DatabaseBackup.stale? ? 'text-red-500' : 'text-slate-500' %>">
        <% if DatabaseBackup.last_success %>
          <%= l(DatabaseBackup.last_success.in_time_zone, format: "%b %-d, %-l:%M %p") %><%= " · overdue" if DatabaseBackup.stale? %>
        <% else %>
          None recorded yet
        <% end %>
      </span>
    </span>
    <%= button_to "Back up now", backup_path, class: "shrink-0 whitespace-nowrap rounded-full bg-slate-200 px-4 py-2 font-medium text-slate-700 hover:bg-slate-300" %>
  <% else %>
    <span class="text-slate-500">Backups aren't set up on this server (no GitHub token).</span>
  <% end %>
</div>

<%= render "shared/section_heading", title: "Players", subtitle: "Rename someone or add a new player. Their games and stats follow the name." %>
<ul class="mt-2 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
  <% @players.each do |player| %>
    <li class="px-4 py-3">
      <%= form_with model: player, class: "flex items-center gap-2" do |form| %>
        <%= form.text_field :name, "aria-label": "Name", required: true, maxlength: 30,
          class: "min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base" %>
        <%= form.submit "Rename", class: "shrink-0 whitespace-nowrap rounded-full bg-slate-200 px-4 py-2 text-base font-medium text-slate-700 hover:bg-slate-300" %>
      <% end %>
    </li>
  <% end %>
  <li class="px-4 py-3">
    <%= form_with model: Player.new, class: "flex items-center gap-2" do |form| %>
      <%= form.text_field :name, "aria-label": "New player", placeholder: "New player", required: true, maxlength: 30,
        class: "min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base" %>
      <%= form.submit "Add", class: "shrink-0 whitespace-nowrap rounded-full bg-blue-600 px-5 py-2 text-base font-medium text-white hover:bg-blue-700" %>
    <% end %>
  </li>
</ul>
