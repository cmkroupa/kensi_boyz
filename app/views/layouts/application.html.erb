<!DOCTYPE html>
<html class="bg-blue-50">
  <head>
    <title><%= content_for(:title) || "KFL" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="KFL">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#2563eb">
    <meta name="apple-mobile-web-app-title" content="KFL">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-blue-50 text-slate-900 antialiased">
    <% if authenticated? %>
      <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-3xl items-center justify-between px-4 pt-4">
          <div class="flex items-center gap-2">
            <%= link_to "KFL", root_path, class: "text-2xl font-bold tracking-tight" %>
            <% if admin? %><span class="rounded-full bg-blue-100 px-2 py-0.5 text-sm font-semibold text-blue-700">Admin</span><% end %>
          </div>
          <%= button_to "Log out", session_path, method: :delete, class: "text-base text-slate-500 hover:text-slate-900" %>
        </div>
        <nav class="mx-auto mt-2 grid max-w-3xl grid-cols-4 px-4 text-center text-base">
          <% { leaderboard: [ "Leaderboard", root_path ], play: [ "Play", play_path ], predict: [ "Predict", prediction_path ], games: [ "Games", games_path ] }.each do |section, (label, path)| %>
            <%= link_to label, path, "aria-current": (nav_section == section ? "page" : nil),
              class: [ "border-b-2 py-3 font-medium", nav_section == section ? "border-blue-600 text-blue-700" : "border-transparent text-slate-500 hover:text-slate-900" ] %>
          <% end %>
        </nav>
      </header>
    <% end %>

    <main class="mx-auto max-w-3xl px-4 py-8">
      <% if notice %>
        <p class="mb-4 rounded-lg bg-blue-50 px-3 py-3 text-base text-blue-800"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="mb-4 rounded-lg bg-rose-50 px-3 py-3 text-base text-rose-800"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>

  </body>
</html>
