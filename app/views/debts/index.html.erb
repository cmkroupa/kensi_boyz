<% content_for :title, "Debts · KFL" %>
<h1 class="text-2xl font-semibold tracking-tight">Debts</h1>

<div class="mt-3 flex flex-wrap gap-2 text-base">
  <% [ [ nil, "Everyone" ], *@players.map { |player| [ player.id, player.name ] } ].each do |id, label| %>
    <%= link_to label, debts_path(player_id: id),
      class: [ "rounded-full px-3 py-1.5", id == @player&.id ? "bg-slate-900 text-white" : "bg-slate-200 text-slate-600" ] %>
  <% end %>
</div>

<h2 class="mt-8 text-base font-semibold uppercase tracking-wide text-slate-500">
  Unpaid<%= " · #{money_text(@pairs.sum { |_, _, owed| owed.sum(&:cents) })}" if @pairs.any? %>
</h2>
<% if @pairs.empty? %>
  <p class="mt-2 text-base text-slate-500">Nobody owes anything.</p>
<% else %>
  <div class="mt-2 space-y-3">
    <% @pairs.each do |debtor, creditor, owed| %>
      <section class="rounded-2xl border border-slate-200 bg-white">
        <div class="flex items-center justify-between gap-3 px-4 py-4">
          <div class="min-w-0">
            <p class="text-base"><span class="font-semibold"><%= debtor.name %></span> owes <span class="font-semibold"><%= creditor.name %></span></p>
            <p class="text-xl font-semibold tabular-nums text-red-500"><%= money_text(owed.sum(&:cents)) %></p>
          </div>
          <%= button_to "Mark all paid", debt_settlements_path, params: { debtor_id: debtor.id, creditor_id: creditor.id },
            data: { turbo_confirm: "#{debtor.name} paid #{creditor.name} #{money_text(owed.sum(&:cents))}?" },
            class: "shrink-0 rounded-full bg-blue-600 px-4 py-2 text-base font-medium text-white hover:bg-blue-700" %>
        </div>
        <details class="border-t border-slate-200">
          <summary class="cursor-pointer px-4 py-3 text-base text-slate-500"><%= pluralize(owed.size, "bet") %></summary>
          <ul class="divide-y divide-slate-100 px-4 pb-2">
            <% owed.each do |debt| %>
              <li class="flex items-center justify-between gap-3 py-2 text-base">
                <%= link_to game_path(debt.game), class: "min-w-0 text-slate-500 hover:text-blue-600" do %>
                  <%= l(debt.game.played_at, format: "%b %-d") %> · <%= debt.game.score_for(debt.game.winner_side) %>–<%= debt.game.score_for(debt.game.loser_side) %>
                <% end %>
                <span class="flex items-center gap-3">
                  <span class="font-semibold tabular-nums"><%= money_text(debt.cents) %></span>
                  <%= button_to "Paid", debt_payment_path(debt), class: "rounded-full bg-slate-200 px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-300" %>
                </span>
              </li>
            <% end %>
          </ul>
        </details>
      </section>
    <% end %>
  </div>
<% end %>

<% if @paid.any? %>
  <h2 class="mt-8 text-base font-semibold uppercase tracking-wide text-slate-500">Paid</h2>
  <ul class="mt-2 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
    <% @paid.each do |debt| %>
      <li class="flex items-center justify-between gap-3 px-4 py-3 text-base">
        <span class="min-w-0">
          <span class="font-medium"><%= debt.debtor.name %></span> paid <span class="font-medium"><%= debt.creditor.name %></span>
          <span class="font-semibold tabular-nums"><%= money_text(debt.cents) %></span>
          <span class="block text-sm text-slate-400"><%= l(debt.paid_at, format: "%b %-d") %></span>
        </span>
        <%= button_to "Mark unpaid", debt_payment_path(debt), method: :delete, class: "shrink-0 rounded-full bg-slate-200 px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-300" %>
      </li>
    <% end %>
  </ul>
<% end %>
