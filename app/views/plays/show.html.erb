<% content_for :title, "Play · KFL" %>
<div class="flex items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">Play</h1>
  <% if Game.exists? %>
    <%= link_to "Rematch last game", play_path(rematch: 1),
      class: "rounded-full bg-slate-200 px-4 py-2 text-base font-medium text-slate-700 hover:bg-slate-300" %>
  <% end %>
</div>
<p class="mt-1 text-base text-slate-500">Pick the teams, add a bet if there is one, and log the score once it's played.</p>

<div class="mt-4 rounded-2xl border border-slate-200 bg-white p-4">
  <%= render "plays/form", game: @game, players: @players %>
</div>
