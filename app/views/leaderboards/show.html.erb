<% content_for :title, "KFL" %>
<div class="flex items-center justify-between">
  <h1 class="text-2xl font-semibold tracking-tight">Leaderboard</h1>
  <% unless @lines %>
    <%= render "shared/mode_toggle", mode: current_mode, path: { name: :root_path, args: [] } %>
  <% end %>
</div>

<div class="mt-3 inline-flex rounded-full bg-slate-200 p-1 text-base">
  <% { "Ratings" => root_path(mode: current_mode), "Money" => root_path(view: "money") }.each do |label, path| %>
    <%= link_to label, path, class: [ "rounded-full px-4 py-1.5 font-medium", (label == "Money") == @lines.present? ? "bg-white shadow-sm" : "text-slate-500" ] %>
  <% end %>
</div>

<%= render(@lines ? "leaderboards/money" : "leaderboards/ratings") %>
