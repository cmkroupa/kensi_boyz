<% content_for :title, "History · KFL" %>
<% if @player %><%= render "shared/back_link", label: @player.name, path: player_path(@player, mode: @mode || "singles") %><% end %>
<h1 class="text-2xl font-semibold tracking-tight">
  <%= @player ? "#{@player.name}’s games" : "History" %>
</h1>
<p class="mt-1 text-base text-slate-500">Every game, newest first, winner on the left. Filter by game type, or show only games with a bet.</p>

<div class="mt-3 flex gap-2 text-base">
  <% { nil => "All", "singles" => "1v1", "doubles" => "2v2" }.each do |mode, label| %>
    <%= link_to label, games_path(player_id: @player&.id, mode: mode, bets: @bets_only || nil),
      class: [ "rounded-full px-3 py-1.5", mode == @mode ? "bg-slate-900 text-white" : "bg-slate-200 text-slate-600" ] %>
  <% end %>
  <%= link_to "Bets only", games_path(player_id: @player&.id, mode: @mode, bets: @bets_only ? nil : 1),
    class: [ "rounded-full px-3 py-1.5", @bets_only ? "bg-green-600 text-white" : "bg-slate-200 text-slate-600" ] %>
</div>

<% if @games.empty? %>
  <p class="mt-6 text-base text-slate-500">Nothing here yet.</p>
<% else %>
  <div class="mt-2 divide-y divide-slate-200">
    <% @games.each do |game| %>
      <% perspective = @player && game.participations.find { |p| p.player_id == @player.id } %>
      <div>
        <%= render "shared/game", game: game, perspective: perspective %>
        <p class="-mt-3 pb-3 text-sm text-slate-400"><%= mode_label(game.mode) %> · <%= l(game.played_at, format: "%b %-d, %-l:%M %p") %><%= " · #{money_text(game.underdog_stake_cents)} bet" if game.bet? %></p>
      </div>
    <% end %>
  </div>
  <div class="mt-4 flex justify-between text-base">
    <% if @page > 1 %><%= link_to "← Newer", games_path(player_id: @player&.id, mode: @mode, bets: @bets_only || nil, page: @page - 1), class: "text-blue-600" %><% else %><span></span><% end %>
    <% if @more %><%= link_to "Older →", games_path(player_id: @player&.id, mode: @mode, bets: @bets_only || nil, page: @page + 1), class: "text-blue-600" %><% end %>
  </div>
<% end %>
