<%# locals: (mode:, path:) %>
<div class="inline-flex rounded-full bg-slate-200 p-1 text-base">
  <% Game.modes.each_key do |key| %>
    <%= link_to mode_label(key), public_send(path[:name], *path[:args], mode: key),
      class: [ "rounded-full px-4 py-1.5 font-medium", key == mode ? "bg-white shadow-sm" : "text-slate-500" ] %>
  <% end %>
</div>
