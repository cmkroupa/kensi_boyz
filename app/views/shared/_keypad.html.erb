<%# locals: (controller:) %>
<div class="grid grid-cols-3 gap-3">
  <% %w[ 1 2 3 4 5 6 7 8 9 ].each do |digit| %>
    <button type="button" data-action="<%= controller %>#press" data-digit="<%= digit %>"
      class="rounded-full border border-slate-200 bg-white py-5 text-3xl font-medium tabular-nums active:bg-slate-100"><%= digit %></button>
  <% end %>
  <span></span>
  <button type="button" data-action="<%= controller %>#press" data-digit="0"
    class="rounded-full border border-slate-200 bg-white py-5 text-3xl font-medium tabular-nums active:bg-slate-100">0</button>
  <button type="button" data-action="<%= controller %>#erase" aria-label="Delete"
    class="rounded-full py-5 text-2xl text-slate-500 active:bg-slate-100">⌫</button>
</div>
