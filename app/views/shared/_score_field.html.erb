<%# locals: (form:, field:, label:) %>
<div data-controller="score" class="mt-3">
  <%= form.hidden_field field, data: { score_target: "input" } %>
  <button type="button" data-action="score#open" data-score-target="display"
    class="h-16 w-32 rounded-xl border border-slate-300 bg-white px-4 py-4 text-center text-3xl font-semibold tabular-nums"></button>

  <dialog data-score-target="dialog" data-action="click->score#backdrop"
    class="m-auto w-80 rounded-3xl bg-white p-5 shadow-xl backdrop:bg-slate-900/30">
    <p class="mb-4 text-center text-base font-semibold uppercase tracking-wide text-slate-500"><%= label %> score</p>
    <%= render "shared/keypad", controller: "score" %>
    <button type="button" data-action="score#close" class="mt-3 w-full rounded-xl bg-blue-600 py-4 font-medium text-white">Done</button>
  </dialog>
</div>
