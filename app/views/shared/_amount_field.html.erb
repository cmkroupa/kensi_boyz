<%# locals: (form:, field:, value: 0) %>
<div data-controller="amount" class="mt-3">
  <%= form.hidden_field field, value: value, data: { amount_target: "input", game_form_target: "bet" } %>
  <button type="button" data-action="amount#open" data-amount-target="display"
    class="h-16 w-full rounded-xl border border-slate-300 bg-white px-4 py-4 text-center text-3xl font-semibold tabular-nums"></button>

  <dialog data-amount-target="dialog" data-action="click->amount#backdrop"
    class="m-auto w-80 rounded-3xl bg-white p-5 shadow-xl backdrop:bg-slate-900/30">
    <p class="mb-4 text-center text-base font-semibold uppercase tracking-wide text-slate-500">Bet in dollars</p>
    <%= render "shared/keypad", controller: "amount" %>
    <button type="button" data-action="amount#close" class="mt-3 w-full rounded-xl bg-blue-600 py-4 font-medium text-white">Done</button>
  </dialog>
</div>
