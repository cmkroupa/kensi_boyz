<div class="mx-auto mt-16 max-w-xs text-center" data-controller="pin">
  <h1 class="text-4xl font-bold tracking-tight">KFL</h1>
  <p class="mt-1 text-base text-slate-500">Enter the PIN</p>

  <%= form_with url: session_path, data: { pin_target: "form" } do |form| %>
    <%= form.hidden_field :passcode, data: { pin_target: "input" } %>

    <div class="mt-6 flex justify-center gap-4" aria-hidden="true">
      <% 4.times do %>
        <span data-pin-target="dot" class="h-3.5 w-3.5 rounded-full border-2 border-slate-400 transition-colors"></span>
      <% end %>
    </div>

    <div class="mt-8"><%= render "shared/keypad", controller: "pin" %></div>
  <% end %>
</div>
