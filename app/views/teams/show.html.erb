<% content_for :title, "#{@partnership.players.map(&:name).to_sentence(two_words_connector: ' & ')} · KFL" %>
<%= render "shared/back_link", label: "Leaderboard", path: root_path(mode: "doubles") %>
<p class="text-base text-slate-500">2v2 team</p>
<h1 class="text-3xl font-bold tracking-tight">
  <% @partnership.players.each_with_index do |player, index| %>
    <%= " & " if index.positive? %><%= link_to player.name, player_path(player, mode: "doubles"), class: "hover:text-blue-600" %>
  <% end %>
</h1>

<%= render "shared/section_heading", title: "Team rating", subtitle: "The average of both players' 2v2 ratings after each game together.", top: "mt-6" %>
<div class="mt-2 rounded-2xl border border-slate-200 bg-white p-4">
  <%= rating_chart(RatingHistory.for_team(@partnership)) %>
</div>

<%= render "shared/section_heading", title: "Stats", subtitle: "Record, scoring and streaks for games these two played together." %>
<dl class="mt-2 grid grid-cols-2 gap-3 text-base sm:grid-cols-4">
  <% [
    [ "Record", "#{@partnership.wins}-#{@partnership.losses}", "" ],
    [ "Win rate", percent_text(@partnership.win_rate), "" ],
    [ "Goals for", @partnership.goals_for, "" ],
    [ "Goals against", @partnership.goals_against, "" ],
    [ "Goal difference", goal_difference_text(@partnership.goals_for, @partnership.goals_against), goal_difference_class(@partnership.goals_for, @partnership.goals_against) ],
    [ "Clean sheets", @partnership.clean_sheets, "" ],
    [ "Streak", @partnership.current_streak.label, streak_class(@partnership.current_streak) ],
    [ "Best win streak", "#{@partnership.longest_win_streak}W", "" ]
  ].each do |label, value, color| %>
    <div class="rounded-xl border border-slate-200 bg-white px-3 py-3">
      <dt class="text-sm text-slate-500"><%= label %></dt>
      <dd class="text-xl font-semibold tabular-nums <%= color %>"><%= value %></dd>
    </div>
  <% end %>
</dl>

<%= render "shared/section_heading", title: "Recent games", subtitle: "The latest 8 together, winner on the left." %>
<div class="mt-2 divide-y divide-slate-200">
  <% @partnership.chronological.last(8).reverse_each do |result| %>
    <%= render "shared/game", game: result.game, perspective: result %>
  <% end %>
</div>
